# Database
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority

# NextAuth Configuration
NEXTAUTH_URL=https://www.presusimple.com
NEXTAUTH_SECRET=your-nextauth-secret-key-here

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Lemon Squeezy Configuration (required for production billing)
# See docs/billing-lemon-squeezy.md for dashboard setup and verification steps.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=

# App Configuration
NEXT_PUBLIC_APP_URL=https://www.presusimple.com

# Admin access (comma-separated emails with platform admin privileges)
ADMIN_EMAILS=mackewinsson@gmail.com
# Optional: mirror for client-side checks before session loads (prefer session.user.isAdmin after sign-in)
NEXT_PUBLIC_ADMIN_EMAILS=mackewinsson@gmail.com

# JWT Configuration
JWT_SECRET=your-jwt-secret-key-here

# Web Push (VAPID) - Generate using: npx web-push generate-vapid-keys
WEBPUSH_PUBLIC_KEY=BNxxxxxxxxxxxxxxxxxxxxxxxx
WEBPUSH_PRIVATE_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
WEBPUSH_CONTACT_EMAIL=mailto:you@example.com

# Client needs public key
NEXT_PUBLIC_VAPID_PUBLIC_KEY=${WEBPUSH_PUBLIC_KEY}

# Dev: keep SW off unless you opt-in
ENABLE_PWA_DEV=false

# Legacy VAPID keys (for backward compatibility)
VAPID_PRIVATE_KEY=${WEBPUSH_PRIVATE_KEY}
VAPID_SUBJECT=${WEBPUSH_CONTACT_EMAIL}

# Production Settings
NODE_ENV=production 